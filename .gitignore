# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Development-only terrain preview renders (N3b visual verification)
game/dev/terrain_preview/output/

# Development-only terrain runtime harness renders (N4 visual verification)
game/dev/terrain_runtime_harness/output/
game/dev/city_asset_preview/output/

# Blender-only terrain prototype noise (N3c.3a VCS cleanup, 2026-08).
# generated/ is .gdignore'd (Godot never scans it); these narrow rules keep
# stray importer output invisible to git. source/ cannot be .gdignore'd because
# source/materials/ holds the runtime terrain textures, so its .blend import
# descriptor is git-ignored instead. Do NOT ignore *.uid or *.import globally:
# sidecars of real scripts/shaders/textures are versioned per Godot 4 policy.
game/assets/prototype/3d/terrain/prototype_3d_terrain/source/*.blend.import
game/assets/prototype/3d/terrain/prototype_3d_terrain/generated/*.blend.import
game/assets/prototype/3d/terrain/prototype_3d_terrain/generated/textures/

# Native GDExtension build output (N3b.1a; build with scripts/build-native.ps1)
native/build/
game/bin/

# Local authority server (Cloud 0.1)
server/data/
**/__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local provider credentials (C1). Only `.env.example` is versioned, and it may
# contain variable names and descriptions but never a value.
.env
.env.*
!.env.example

# Asset-generation job artifacts (C1). Provider outputs are large binaries and
# are reproducible from the manifests, which ARE versioned so a job stays
# resumable and auditable after a clean checkout.
artifacts/assetgen/jobs/*/outputs/
artifacts/assetgen/jobs/*/response/

# Local run reports (C1/A2.11). Per-asset ingestion verdicts, the pre-upload gate
# and shield plans are written by the CLI on every run and are reproducible by
# rerunning it on the same local asset, so they are diagnostics of one machine's
# run rather than sources. No test reads them.
artifacts/assetgen/rig_ingest/
artifacts/assetgen/humanoid/
artifacts/assetgen/shield/
# Provider pre-plans. Deterministic: the same input and configuration always
# regenerate the same plan and the same digest, so the digest quoted in a review
# is verifiable by rerunning `provider-plan` rather than by trusting a file.
artifacts/assetgen/plans/

# Submission ledger. One file per approved plan digest, created with O_EXCL so
# one approval buys exactly one paid job. It is per-machine spend history, not a
# source, and committing it would let a checkout resurrect or block a claim.
artifacts/assetgen/submissions/

# Staged hand-fixture artifacts (A2.11). Everything here is compiler output for a
# candidate rig, including CLASSIFIED-FAIL artifacts kept for diagnostics. Only
# an ACCEPTED chain publishes an artifact to its unit's asset folder, and that
# published file IS versioned. Staging must never look like an accepted fixture.
game/artifacts/fixtures/staging/
game/artifacts/static_export/staging/

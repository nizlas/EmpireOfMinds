# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Development-only terrain preview renders (N3b visual verification)
game/dev/terrain_preview/output/

# Blender-only terrain prototype noise (N3c.3a VCS cleanup, 2026-08).
# generated/ is .gdignore'd (Godot never scans it); these narrow rules keep
# stray importer output invisible to git. source/ cannot be .gdignore'd because
# source/materials/ holds the runtime terrain textures, so its .blend import
# descriptor is git-ignored instead. Do NOT ignore *.uid or *.import globally:
# sidecars of real scripts/shaders/textures are versioned per Godot 4 policy.
game/assets/prototype/3d/terrain/prototype_3d_terrain/source/*.blend.import
game/assets/prototype/3d/terrain/prototype_3d_terrain/generated/*.blend.import
game/assets/prototype/3d/terrain/prototype_3d_terrain/generated/textures/

# Native GDExtension build output (N3b.1a; build with scripts/build-native.ps1)
native/build/
game/bin/

# Local authority server (Cloud 0.1)
server/data/
**/__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Empire of Minds — tooling credentials (template).
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored and must
# never be committed. These variables are read ONLY by backend/tooling under
# `tools/`; the Godot gameplay client never sees a provider credential.
#
# Nothing in this file may contain a real secret. Values here are descriptions.

# Asset generation provider: images and image-to-3D meshes.
# Used by: python -m tools.assetgen (meshy adapter)
MESHY_API_KEY=

# Character auto-rig provider.
# Used by: python -m tools.assetgen autorig (uthana adapter)
UTHANA_API_KEY=

# Optional overrides, normally left unset. Point an adapter at a mock or a
# staging host without touching code.
# MESHY_API_BASE=https://api.meshy.ai
# UTHANA_API_BASE=https://api.uthana.com
